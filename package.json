{
  "name": "pi-acp-adapter",
  "version": "0.1.0",
  "description": "Generic ACP v1 stdio delegation extension for Pi",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "pi-package",
    "pi",
    "acp",
    "agent-client-protocol",
    "codex",
    "extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.12.0",
    "@agentclientprotocol/sdk": "^1.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "20.19.43",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
